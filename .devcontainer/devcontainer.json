// .devcontainer/devcontainer.json
{
  "name": "Crafting Interpreters",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",

  "postCreateCommand": [
    "curl -LO https://storage.googleapis.com/dart-archive/channels/stable/release/2.19.6/sdk/dartsdk-linux-x64-release.zip",
    "unzip -o dartsdk-linux-x64-release.zip",
    "rm dartsdk-linux-x64-release.zip"
  ],

  "containerEnv": {
    "PATH": "/workspaces/${containerWorkspaceFolderBasename}/dart-sdk/bin:${PATH}"
  }
}
